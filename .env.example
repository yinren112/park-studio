# Copy to .env before using Docker Compose. These are placeholders, not deployed credentials.
LAILIN_OPERATOR_PASSWORD=replace-with-a-unique-password
LAILIN_MODE=simulated
LAILIN_GATEWAY_TOKEN=
LAILIN_SECURE_COOKIE=0
LAILIN_PUBLIC_ORIGIN=

# For the publish profile, set your real domain, point its DNS to the host,
# then set secure cookies to 1 and the public origin to https://your-domain.
PARK_DOMAIN=park.example.com
