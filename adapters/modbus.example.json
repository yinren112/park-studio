{
  "source": "modbus-simulator",
  "model": "Renke RS-WS-N01-8-T register profile (protocol simulator)",
  "deviceId": "ENV-01",
  "transport": "tcp",
  "host": "127.0.0.1",
  "port": 15020,
  "unitId": 1,
  "baudrate": 4800,
  "parity": "N",
