  "pollSeconds": 2,
  "timeoutSeconds": 1,
  "endpoint": "http://127.0.0.1:18868/api/telemetry",
  "tokenEnv": "LAILIN_GATEWAY_TOKEN",
  "stateFile": "../data/modbus-simulator-state.json"
}
